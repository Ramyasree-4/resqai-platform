# ═══════════════════════════════════════════════════════
# ResQAI Backend – Environment Variables
# NEVER commit this file to version control.
# ═══════════════════════════════════════════════════════

# ── Application ────────────────────────────────────────
APP_NAME=ResQAI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
PORT=8000

# ── DEMO MODE (no Firebase/Firestore needed) ────────────────────────
# Set to true for hackathon demo — uses in-memory store + local JWT
DEMO_MODE=true

# ── Firebase ───────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_PROJECT_ID=resqai-dd624
FIREBASE_STORAGE_BUCKET=resqai-dd624.firebasestorage.app
FIREBASE_WEB_API_KEY=AIzaSyCwQ5pVApCJTl-tdNOMOE9bp_AgktJsZv8

# ── Mistral AI (Primary LLM) ───────────────────────────
MISTRAL_API_KEY=lHul3vFrjJToG7A9il87ln5J8O5Hv2o0
MISTRAL_MODEL=mistral-large-latest
MISTRAL_TIMEOUT_SECONDS=30
MISTRAL_MAX_RETRIES=3

# ── Google Gemini AI (Fallback LLM) ────────────────────
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-1.5-pro
GEMINI_PRIMARY_MODEL=gemini-1.5-pro
GEMINI_FLASH_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=3

# ── LangSmith Observability ────────────────────────────
# These exact variable names are required by the tracer code
LANGSMITH_API_KEY=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
LANGCHAIN_API_KEY=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
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=ResQAI
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── AI Circuit Breaker ─────────────────────────────────
AI_CIRCUIT_BREAKER_THRESHOLD=5
AI_CIRCUIT_BREAKER_TIMEOUT=60

# ── JWT ────────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET_KEY=resqai-dev-secret-key-change-in-production-2024!!
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ───────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Rate Limiting ──────────────────────────────────────
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_AI=20/minute

# ── Google Maps (optional for dev) ─────────────────────
GOOGLE_MAPS_API_KEY=your-maps-api-key-here

# ── Notifications (optional for dev) ───────────────────
SENDGRID_API_KEY=your-sendgrid-key-here
SENDGRID_FROM_EMAIL=alerts@resqai.in
MSG91_API_KEY=your-msg91-key-here
MSG91_SENDER_ID=RESQAI

# ── Cloud Storage ──────────────────────────────────────
GCS_MEDIA_BUCKET=resqai-media
GCS_EXPORTS_BUCKET=resqai-exports
MAX_UPLOAD_SIZE_MB=50

# ── Logging ────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=text

# ── SLA (minutes) ──────────────────────────────────────
SLA_CRITICAL_MINUTES=30
SLA_HIGH_MINUTES=60
SLA_MEDIUM_MINUTES=120
SLA_LOW_MINUTES=240
